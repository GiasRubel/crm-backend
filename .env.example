# ─────────────────────────────────────────────────────────────────────────────
# CRM backend configuration
#
# Copy to `.env` and fill in. Every value marked GENERATE must be unique to
# your installation — the app refuses to boot with NODE_ENV=production while any
# of them still holds a placeholder (see src/config/env-validation.ts).
#
#   cp .env.example .env
#   openssl rand -hex 32      # one fresh value per GENERATE line
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# "standalone" = single-organisation install (Regular License)
# "saas"       = multi-tenant with Stripe billing (Extended License)
DEPLOYMENT_MODE=standalone

# ── Database (required) ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/crm

# ── Frontend origin (required) ───────────────────────────────────────────────
# Used for CORS and for building links in outbound email.
FRONTEND_URL=http://localhost:3001

# ── Secrets — GENERATE one unique value each ─────────────────────────────────
# Signs local-auth (email/password) sessions. Sharing these across
# installations makes every session forgeable on all of them.
LOCAL_JWT_ACCESS_SECRET=
LOCAL_JWT_REFRESH_SECRET=
LOCAL_JWT_ACCESS_TTL_SECONDS=900
LOCAL_JWT_REFRESH_TTL_SECONDS=2592000

# Encrypts per-organisation SMTP passwords (Settings › Email) at rest.
MAIL_SETTINGS_ENCRYPTION_KEY=

# Encrypts connected-calendar OAuth tokens at rest.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ── Keycloak SSO (optional — only for orgs with authProvider="keycloak") ─────
KEYCLOAK_AUTH_SERVER_URL=http://localhost:18080
KEYCLOAK_REALM=crm-realm
KEYCLOAK_CLIENT_ID=crm-frontend
# Confidential client used for admin operations (user provisioning).
KEYCLOAK_ADMIN_CLIENT_ID=crm-backend-service
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Outbound email (optional; per-org SMTP in Settings › Email overrides) ────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=CRM

# Extra SMTP hosts an organisation admin may point their own mail settings at,
# as a comma-separated allowlist. Leave empty to allow only the well-known
# providers baked into src/mail-settings/smtp-host-allowlist.ts. Anything not
# listed is rejected — an arbitrary host would make this an SSRF primitive.
MAIL_SMTP_HOST_ALLOWLIST=

# ── Licence activation (optional) ────────────────────────────────────────────
# WARNING: the current implementation calls the Envato API directly from this
# server, which means the token below is the *author's* token. Sharing an Envato
# API key with buyers violates Envato's API terms — see H2 in
# CRM-RELEASE-REVIEW.md. Do not distribute a build that requires this.
ENVATO_PERSONAL_TOKEN=
ENVATO_ITEM_ID=

# ── Calendar sync (optional) — see CALENDAR-SYNC-SETUP.md ────────────────────
# Redirect URIs to register with each provider:
#   ${FRONTEND_URL}/api/backend/calendar-sync/google/callback
#   ${FRONTEND_URL}/api/backend/calendar-sync/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT_ID=common

# ── Stripe (SaaS mode only) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where uploaded attachments are written. Defaults to ./uploads.
UPLOADS_DIR=

# ── Background jobs ──────────────────────────────────────────────────────────
# How often the SLA/automation sweep runs, in minutes. Defaults to 15.
AUTOMATION_SLA_SWEEP_MINUTES=

# ── API docs ─────────────────────────────────────────────────────────────────
# Swagger at /api is served only when this is "true". Off by default: the schema
# enumerates every endpoint and payload shape for an attacker.
ENABLE_SWAGGER=false
